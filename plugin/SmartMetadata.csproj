<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.SmartMetadata</AssemblyName>
    <Version>0.1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <NativeLibraryFile Condition="$([MSBuild]::IsOSPlatform('Linux'))">libjellyfin_smart_metadata.so</NativeLibraryFile>
    <NativeLibraryFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libjellyfin_smart_metadata.dylib</NativeLibraryFile>
    <NativeLibraryFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">jellyfin_smart_metadata.dll</NativeLibraryFile>
    <NativeLibraryName>jellyfin_smart_metadata-$(NETCoreSdkPortableRuntimeIdentifier)$([System.IO.Path]::GetExtension('$(NativeLibraryFile)'))</NativeLibraryName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="meta.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../target/release/$(NativeLibraryFile)" Link="$(NativeLibraryName)" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>

  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)../dist" />
    <ZipDirectory
        SourceDirectory="$(OutDir)"
        DestinationFile="$(MSBuildThisFileDirectory)../dist/smart-metadata_$(Version).zip"
        Overwrite="true" />
  </Target>

</Project>
